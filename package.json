{
  "name": "chismosito",
  "version": "0.1.0",
  "description": "Grabadora de reuniones local con transcripción whisper.cpp y resumen por LLM",
  "main": "./out/main/index.js",
  "author": "Carlos",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-electron.cjs && electron-vite dev",
    "start": "node scripts/ensure-electron.cjs && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && node scripts/ensure-electron.cjs && electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/ensure-electron.cjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dayjs": "^1.11.23",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "gray-matter": "^4.0.3",
    "openai": "^7.57.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}
