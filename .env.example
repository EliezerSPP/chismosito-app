# LLM (OpenCode Zen es OpenAI-compatible)
# Puedes usar la raíz del gateway: la app añade /openai/v1 automáticamente.
# La API key ya no va aquí: se configura en Ajustes → Resumen con LLM y se
# guarda cifrada con DPAPI en %APPDATA%\chismosito\secrets.json.
# (Si este archivo trae OPENCODE_API_KEY y aún no existe secrets.json, la app
#  la adopta una sola vez en el primer arranque.)
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash

# Jev (sugerencia de carpeta al terminar; usa la misma API key)
# jev-1.13-free es gratis por tiempo limitado; jev-1.13 es de pago.
JEV_MODEL=jev-1.13-free
JEV_BASE_URL=https://opencode.ai/inference/systemone/v1/systemone

# Google Drive (cliente OAuth tipo "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=Chismosito
GOOGLE_DRIVE_AUTO_BACKUP=true

# Rutas y whisper
MEETING_NOTES_DIR=
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=es
WHISPER_MODEL_PATH=
USER_NAME=
